/target

# Runtime log from upscale_art.py.
/upscale.log
/upscale-failed.txt
/imagex-upscale.log
/imagex-failed.txt
# Local cloud-upscale helper contains the user's ImageX credentials.
/imagex_upscale.py

# Local agent notes (keep on this machine only).
/AGENTS.md

# Game assets are stored outside git history: they are published as split
# archives on a private GitHub Release and restored with tools/fetch_data.py.
/data
/release

# Derived runtime caches (regenerated by the tools/ scripts).
/data/cache
/data/bg_2x
/data/sprite_2x
/data/bg_cn_2x

# Game content as loose files. Built once from the user's own copy of the game
# by tools/build_data_tree.py. The asset trees are tracked on purpose in this
# private repository (the 8x WebP trees are the source of truth); derived
# caches and proxy trees above stay out of it.

# Intermediate numpy/rasterizer artifacts from tools/ experiments.
*.npy
tools/verify/

# Character/font sample rasters (copyrighted artwork, like /data).
tools/samples/
__pycache__/
tools/__pycache__/
