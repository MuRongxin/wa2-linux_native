/target

# Runtime log from upscale_art.py.
/upscale.log
/upscale-failed.txt
/imagex-upscale.log
/imagex-failed.txt
# Local cloud-upscale helper contains the user's ImageX credentials.
/imagex_upscale.py

# Derived runtime caches (regenerated by the tools/ scripts).
/data/cache
/data/bg_2x
/data/sprite_2x
/data/bg_cn_2x

# Game content as loose files. Built once from the user's own copy of the game
# by tools/build_data_tree.py -- never commit (huge + copyrighted).
/data/bg
/data/sprite
/data/bg_cn
/data/script
/data/script_cn
/data/voice
/data/bgm
/data/se
/data/movie
/data/font
/data/save


# Intermediate numpy/rasterizer artifacts from tools/ experiments.
*.npy
tools/verify/

# Character/font sample rasters (copyrighted artwork, like /data).
tools/samples/
__pycache__/
tools/__pycache__/
