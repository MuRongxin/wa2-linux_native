/target
/bin/
/bin_/

# AppImage artifacts stay outside Git, regardless of their directory/name.
*.AppImage
*.AppImage.sha256
*.AppImage.part
/others/
/tools/*
!/tools/macos_acceptance.py
!/tools/test_macos_acceptance.py
!/tools/MACOS_ACCEPTANCE.md

# Local agent notes (keep on this machine only).
/AGENTS.md

# Game assets and local acquisition caches must stay outside source history.
/data
/release
/docs
/.wa2-release-parts/

# Derived runtime caches (regenerated by the tools/ scripts).
/data/cache
/data/bg_2x
/data/sprite_2x
/data/bg_cn_2x

# Keep loose game content, derived caches, captures and local diagnostics out
# of commits. Only explicitly allowlisted acceptance tools belong in /tools.

# Intermediate numpy/rasterizer artifacts from tools/ experiments.
*.npy
tools/verify/

# Character/font sample rasters (copyrighted artwork, like /data).
tools/samples/
__pycache__/
tools/__pycache__/

# Local upscale-runner pid file (not part of the project).
run_sprite.pid
